<div class="docs-layout">
  <!-- Desktop sidebar; hidden below 64rem, where the drawer takes over -->
  <aside class="docs-sidebar">
    <div>
      <nav class="docs-nav-scroll" aria-label="Documentation navigation">
        <div class="docs-toc-navigation" id="toc"><%- include('toc') %></div>
      </nav>
    </div>
  </aside>

  <main class="docs-main">
    <article class="prose">
      <div id="content">
        <%- slot() %>
        <% if (meta('source')) { %>
        <p class="edit-page">
          <a href="https://github.com/pockethost/pocketone/edit/main/<%= meta('source') %>" target="_blank">Edit this page on GitHub</a>
        </p>
        <% } %>
      </div>
    </article>
  </main>
</div>
