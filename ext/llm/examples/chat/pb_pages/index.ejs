<%
  const llm = ctx.resolve('llm')
%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PocketOne Docs Chat</title>
<style>
  :root {
    --bg: #f7f7f5; --panel: #ffffff; --text: #1d1d1b; --muted: #6b6b66; --line: #e4e4df;
    --me: #1f6feb; --me-text: #ffffff; --accent: #1f6feb; --warn: #9a6700; --err: #c62828;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #141414; --panel: #1e1e1e; --text: #ececea; --muted: #9a9a94; --line: #2e2e2c;
            --me: #2f81f7; --me-text: #ffffff; --accent: #58a6ff; --warn: #d29922; --err: #f85149; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px; min-height: 100vh; display: flex; flex-direction: column; }
  header { padding: 20px 0 12px; border-bottom: 1px solid var(--line); }
  header h1 { margin: 0; font-size: 18px; }
  #status, .armed { margin-top: 4px; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
  #status.warn { color: var(--warn); } #status.err { color: var(--err); }
  .armed code { font-size: 12px; }
  #log { flex: 1; padding: 16px 0; display: flex; flex-direction: column; gap: 14px; }
  .msg { max-width: 88%; padding: 10px 14px; border-radius: 14px; overflow-wrap: anywhere; }
  .me { white-space: pre-wrap; }
  .bot p, .bot ul, .bot ol, .bot pre, .bot h4 { margin: 0 0 8px; }
  .bot > :last-child { margin-bottom: 0; }
  .bot ul, .bot ol { padding-left: 22px; }
  .bot li { margin: 2px 0; }
  .bot h4 { font-size: 15px; }
  .bot a { color: var(--accent); }
  .me { align-self: flex-end; background: var(--me); color: var(--me-text); border-bottom-right-radius: 4px; }
  .bot { align-self: flex-start; background: var(--panel); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
  code { background: color-mix(in srgb, var(--text) 9%, transparent); padding: 1px 5px; border-radius: 4px;
         font: 13px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .bot pre { margin: 8px 0; padding: 10px 12px; border-radius: 8px; overflow-x: auto; white-space: pre;
             background: color-mix(in srgb, var(--text) 7%, transparent); }
  .bot pre code { background: none; padding: 0; }
  .meta { margin-top: 8px; font-size: 12px; color: var(--muted); white-space: normal; }
  .meta a { color: var(--accent); text-decoration: none; } .meta a:hover { text-decoration: underline; }
  .thinking { color: var(--muted); font-style: italic; }
  .error { color: var(--err); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .chips button, .empty button { padding: 5px 11px; border-radius: 999px; border: 1px solid var(--line);
         background: var(--panel); color: var(--text); cursor: pointer; font: inherit; font-size: 13px; }
  .chips button:hover, .empty button:hover { border-color: var(--accent); }
  .empty { color: var(--muted); text-align: center; margin-top: 16vh; }
  .empty .chips { justify-content: center; }
  form { position: sticky; bottom: 0; background: var(--bg); padding: 12px 0 20px; display: flex; gap: 8px; }
  textarea { flex: 1; resize: none; height: 46px; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line);
             background: var(--panel); color: var(--text); font: inherit; }
  textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  button.send { padding: 0 18px; border: 0; border-radius: 12px; background: var(--accent); color: #fff; font: inherit;
                font-weight: 600; cursor: pointer; } button.send:disabled { opacity: .5; cursor: default; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>PocketOne Docs Chat</h1>
    <div id="status">Answered by <code><%= llm.MODEL %></code> (set <code>CHAT_MODEL</code> to change it)</div>
    <div class="armed" id="armed">Loading the docs from <code><%= llm.DOCS_URL %></code>…</div>
  </header>
  <div id="log">
    <div class="empty" id="empty">
      <p>Ask about PocketOne.</p>
      <div class="chips">
        <button>How do I restore my database to an earlier moment?</button>
        <button>How do I run many apps on one server?</button>
        <button>What is PocketPages?</button>
      </div>
    </div>
  </div>
  <form id="f">
    <textarea id="q" placeholder="Ask a question…" autofocus></textarea>
    <button class="send" id="send">Send</button>
  </form>
</div>
<script>
const log = document.getElementById('log'), q = document.getElementById('q'), send = document.getElementById('send')
const statusEl = document.getElementById('status')

// the docs load on the server on first use (and every 10 minutes); show what the chat answers from
fetch('/chat').then(r => r.json()).then(r => {
  const el = document.getElementById('armed')
  el.innerHTML = r.error ? `<span class="error">Couldn't load the docs: ${esc(r.error)}</span>`
    : `Armed with <code>preamble.md</code>, ${r.pages} pages of PocketOne's user docs (<code>${esc(r.docs)}</code>) and ` +
      (r.pbError ? `<span class="error">no PocketBase docs (${esc(r.pbError)})</span>` : `${r.pbPages} pages of PocketBase's docs`) +
      ` (${r.sections} sections)`
}).catch(() => {})
const history = [] // for the follow-up suggestions only: the server's chat keeps the conversation
let chatId = '' // the stored chat ($llm.chat); a new one per page load

function esc(s) { return s.replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c])) }
// Markdown for the model's answers: paragraphs, lists, headings, ``` blocks, `code`, **bold**, *italic* and links.
// Everything is escaped first; links only become links for http(s) URLs.
function inline(s) {
  const codes = []
  s = esc(s).replace(/`([^`\n]+)`/g, (_, c) => `\u0000${codes.push(c) - 1}\u0000`) // keep code spans as they are
  s = s.replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
    .replace(/(^|[\s(])(https?:\/\/[^\s<)]+[^\s<).,;:!?])/g, '$1<a href="$2" target="_blank" rel="noopener">$2</a>')
    .replace(/\*\*([^*\n]+)\*\*/g, '<b>$1</b>')
    .replace(/(^|[^*\w])\*([^*\n]+)\*(?!\w)/g, '$1<i>$2</i>')
  return s.replace(/\u0000(\d+)\u0000/g, (_, n) => `<code>${codes[n]}</code>`)
}
function md(text) {
  const out = []
  let list = null, para = []
  const endPara = () => { if (para.length) { out.push(`<p>${para.map(inline).join('<br>')}</p>`); para = [] } }
  const endList = () => { if (list) { out.push(`</${list}>`); list = null } }
  const parts = text.split(/^```[a-zA-Z0-9_-]*[ \t]*$/m)
  parts.forEach((part, i) => {
    if (i % 2) { endPara(); endList(); out.push(`<pre><code>${esc(part.replace(/^\n|\n$/g, ''))}</code></pre>`); return }
    for (const line of part.split('\n')) {
      let m
      if (!line.trim()) { endPara(); endList(); continue }
      if ((m = line.match(/^\s*([-*+]|\d+[.)])\s+(.*)$/))) {
        const kind = /\d/.test(m[1]) ? 'ol' : 'ul'
        endPara()
        if (list !== kind) { endList(); out.push(`<${kind}>`); list = kind }
        out.push(`<li>${inline(m[2])}</li>`)
      } else if ((m = line.match(/^(#{1,4})\s+(.*)$/))) {
        endPara(); endList(); out.push(`<h4>${inline(m[2])}</h4>`)
      } else {
        endList(); para.push(line.trim())
      }
    }
  })
  endPara(); endList()
  return out.join('')
}

// Keep the newest text in view while it's written, below the sticky input box, but only while the reader is at the
// bottom: scrolling up to reread isn't undone by the next token.
const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 80
const toBottom = () => window.scrollTo({top: document.documentElement.scrollHeight})
function follow(change) { const stick = atBottom(); change(); if (stick) toBottom() }

function add(cls, html) {
  document.getElementById('empty')?.remove()
  const d = document.createElement('div')
  d.className = 'msg ' + cls
  d.innerHTML = html
  log.appendChild(d)
  toBottom() // a new message always shows
  return d
}

// POSTs body and calls onEvent(event, data) for each server-sent event in the response (data parsed as JSON)
async function streamPost(url, body, onEvent) {
  const res = await fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)})
  if (!res.ok || !res.body) throw new Error(res.statusText)
  const reader = res.body.pipeThrough(new TextDecoderStream()).getReader()
  let buf = ''
  for (;;) {
    const {value, done} = await reader.read()
    if (done) break
    buf += value
    let i
    while ((i = buf.indexOf('\n\n')) >= 0) {
      const block = buf.slice(0, i)
      buf = buf.slice(i + 2)
      let event = 'message', data = ''
      for (const line of block.split('\n')) {
        if (line.startsWith('event:')) event = line.slice(6).trim()
        else if (line.startsWith('data:')) data += line.slice(5).trimStart()
      }
      if (data) onEvent(event, JSON.parse(data))
    }
  }
}

async function post(url, body) {
  const res = await fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)})
  const r = await res.json()
  if (!res.ok) throw new Error(r.error || r.message || res.statusText)
  return r
}

async function ask(text) {
  add('me', esc(text))
  history.push({role: 'user', content: text})
  const pending = add('bot', '<span class="thinking">Thinking…</span>')
  send.disabled = true
  const t = Date.now()
  const tick = setInterval(() => { pending.innerHTML = `<span class="thinking">Thinking… ${Math.round((Date.now() - t) / 1000)} s</span>` }, 1000)
  try {
    let written = '', r // the answer so far (text is the question)
    // the answer streams in as server-sent events: "text" pieces, then "done" with the sources
    await streamPost('/chat', {chat: chatId, question: text}, (event, data) => {
      if (event === 'text') {
        if (!written) clearInterval(tick)
        written += data
        follow(() => { pending.innerHTML = md(written) + '<span class="thinking"> ▍</span>' })
      } else if (event === 'done') r = data
      else if (event === 'error') throw new Error(data)
    })
    if (!r) throw new Error('the answer stopped early')
    chatId = r.chat
    history.push({role: 'assistant', content: r.answer})
    const src = r.sources.map(s => s.url ? `<a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.title)}</a>` : esc(s.title)).join(' · ')
    follow(() => {
      pending.innerHTML = md(r.answer) +
        `<div class="meta">${esc(r.model)} · ${(r.ms / 1000).toFixed(1)} s · ${r.usage.inputTokens} in (${r.usage.cachedTokens || 0} cached) / ${r.usage.outputTokens} out` +
        // usage.costMicroUSD: millionths of a dollar the provider charged, or (costEstimated) worked out from listed prices
        (r.usage.costMicroUSD ? ` · <span title="${r.usage.costEstimated ? 'estimated from the model\'s listed prices' : 'what the provider charged'}">${r.usage.costEstimated ? '≈ ' : ''}${usd(r.usage.costMicroUSD / 1e6)}</span>` : '') +
        `<br>Armed with: ${r.armedWith.map(f => `<code>${esc(f)}</code>`).join(' ')}` +
        (src ? `<br>Sources: ${src}` : '') + '</div>'
    })
    suggest(pending, text, r.answer)
  } catch (err) {
    history.pop()
    pending.innerHTML = `<span class="error">${esc(err.message)}</span>`
  } finally { clearInterval(tick); send.disabled = false; q.focus() }
}

// a dollar amount small enough to read: $0.0012, $0.000034
function usd(n) {
  if (n === 0) return '$0'
  return '$' + (n >= 0.01 ? n.toFixed(2) : n.toPrecision(2).replace(/0+$/, ''))
}

// follow-up questions: a second $llm call that answers with JSON matching a schema: three strings
async function suggest(el, question, answer) {
  try {
    const r = await post('/chat/suggest', {question, answer})
    const chips = document.createElement('div')
    chips.className = 'chips'
    for (const s of r.questions || []) {
      const b = document.createElement('button')
      b.textContent = s
      chips.appendChild(b)
    }
    follow(() => el.appendChild(chips))
  } catch {}
}

document.getElementById('f').addEventListener('submit', e => {
  e.preventDefault()
  const text = q.value.trim()
  if (!text || send.disabled) return
  q.value = ''
  ask(text)
})
q.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); document.getElementById('f').requestSubmit() } })
log.addEventListener('click', e => {
  if (e.target.matches('.chips button') && !send.disabled) ask(e.target.textContent)
})
</script>
</body>
</html>
