<%- include('/oauth/head') %>
<%# The user form by default; data.superuser is the superuser form ("use:_superusers"). Every button posts a step:
    password, request_otp, oauth2:<provider>, use:<collection> (switch forms; "use:" is the default user form). %>
<% if (data.superuser) { %><span class="badge">Superuser</span><h1>Superuser sign-in</h1>
<p class="sub">to <%= data.appName %><% if (data.clientName) { %>, to continue to <%= data.clientName %><% } %></p>
<p class="warn">A superuser has full control of <%= data.appName %>. Only sign in here if you mean to give <%= data.clientName || 'this app' %> that power.</p>
<% } else { %><h1>Sign in to <%= data.appName %></h1>
<p class="sub">to continue<% if (data.clientName) { %> to <%= data.clientName %><% } %></p><% } %>
<% if (data.error) { %><p class="err"><%= data.error %></p><% } %>
<form method="post" action="<%= data.action %>"><%- include('/oauth/hidden') %><input type="hidden" name="collection" value="<%= data.collection %>">
<% if (data.collections.length > 1) { %><div class="tabs"><% for (const c of data.collections) { %><button class="tab<%= c === data.collection ? ' on' : '' %>" name="step" value="use:<%= c %>" formnovalidate><%= c %></button><% } %></div><% } %>
<% if (data.passwordEnabled || data.otpEnabled) { %>
<label for="email"><%= data.identityLabel %></label><input id="email" type="<%= data.identityLabel === 'Email' ? 'email' : 'text' %>" name="email" value="<%= data.email %>" autocomplete="username" required autofocus>
<% } %>
<% if (data.passwordEnabled) { %>
<label for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password">
<button class="btn" name="step" value="password">Sign in</button>
<% } %>
<% if (data.otpEnabled) { %><button class="<%= data.passwordEnabled ? 'link' : 'btn' %>" name="step" value="request_otp" formnovalidate>Email me a sign-in code</button><% } %>
<% if (data.providers.length) { %>
<% if (data.passwordEnabled || data.otpEnabled) { %><p class="or">or</p><% } %>
<% for (const p of data.providers) { %><button class="btn secondary" name="step" value="oauth2:<%= p.name %>" formnovalidate>Continue with <%= p.displayName %></button><% } %>
<% } %>
<% if (data.superuserLink) { %><p class="alt"><button class="link" name="step" value="use:_superusers" formnovalidate>Sign in as a superuser</button></p><% } %>
<% if (data.userLink) { %><p class="alt"><button class="link" name="step" value="use:" formnovalidate>Sign in as a user instead</button></p><% } %>
</form>
<%- include('/oauth/foot') %>
